# Copy this file to .env and fill in your keys.

# --- LLM provider (need one) ---
# OpenRouter is preferred (Claude Sonnet by default); Mistral is the fallback,
# used only when OPENROUTER_API_KEY is unset.

# OpenRouter API key (https://openrouter.ai/) — preferred
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Mistral API key (https://console.mistral.ai/) — fallback
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# --- Web search (cross-reference) ---
# Tavily API key for web search (https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# How many corroborating sources to fetch when cross-referencing
CROSS_REFERENCE_K=5

# --- Optional: local NLI stance labeler ---
# NLI_BACKEND=local              # use the fine-tuned DeBERTa instead of the LLM
# NLI_MODEL=models/nli/deberta-v3-base-vitc

# --- Optional: score calibration ---
# CALIBRATION_PATH=models/calibration/default_gonzaloa.json

# Server
HOST=0.0.0.0
PORT=8000
